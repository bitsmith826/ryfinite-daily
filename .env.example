# Konfigurasi Notifikasi Telegram Bot (Opsional)
# Buat bot melalui @BotFather di Telegram untuk mendapatkan Token
# Dapatkan Chat ID Anda melalui bot @userinfobot

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Notifikasi akan dikirim jika sisa masa aktif token <= hari ini (default 3 hari)
EXPIRY_ALERT_DAYS=3
